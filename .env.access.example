# Optional small-team mode. Existing local data is not imported or shared.
ACCESS_MODE=team
ACCESS_DATA_ROOT=data/team
# Keep true for HTTPS deployments. For loopback HTTP development only, set false.
ACCESS_COOKIE_SECURE=true
ACCESS_SESSION_SECONDS=28800
ACCESS_MAX_OPEN_WORKSPACES=8
# Exact browser origins, without trailing slash. No wildcard or proxy-header inference.
ACCESS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
