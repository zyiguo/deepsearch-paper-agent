# Copy to a private .env.database.compose and replace all three password placeholders.
# This file is used only by docker compose --env-file .env.database.compose.
POSTGRES_ADMIN_PASSWORD=replace-with-admin-password
POSTGRES_APP_PASSWORD=replace-with-application-password
# Same application password, URL-encoded; hostname is the Compose service.
DATABASE_URL=postgresql://deepsearch:replace-with-application-password@postgres:5432/deepsearch
