# Optional business database. Copy to .env.database only when explicitly enabling PostgreSQL.
DATABASE_BACKEND=postgresql
DATABASE_URL=postgresql://deepsearch:replace-with-url-encoded-password@127.0.0.1:5432/deepsearch
DATABASE_SCHEMA=deepsearch
DATABASE_POOL_SIZE=8
DATABASE_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
