# 硅基流动 BGE-M3 Embedding 配置模板。
# 在本机填写硅基流动 API Key，不要提交或分享填写密钥后的文件。
# 实际配置文件为项目根目录 .env.embedding；修改后需重启后端。
# 不要复用其他服务商的 API Key。
EMBEDDING_BACKEND=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 这里选择不带 Pro/ 前缀的模型名称。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
RETRIEVAL_MODE=hybrid

# 更换模型后必须重建文档向量，即使新旧模型维度相同也不能混用。
# 保留旧索引以便回退；重复上传可能触发去重，不能代替索引重建。
# 模型可用性、价格、配额和限流以服务商控制台为准。
