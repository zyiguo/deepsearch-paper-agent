# Chat LLM (OpenAI-compatible). Copy to .env and fill in.
LLM_BACKEND=openai_compatible
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model
# Optional:
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_CONTEXT_WINDOW=32768

# MiMo-V2.6-Pro profile (official limits checked 2026-10-06):
# LLM_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_MODEL=mimo-v2.6-pro
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_CONTEXT_WINDOW=1048576
# Provider output ceiling: 131072; 32768 is this project's operating budget.

# Offline demo (no network):
# LLM_BACKEND=demo
