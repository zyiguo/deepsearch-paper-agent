# Independent image vector space. Never use a text-only embedding model here.
IMAGE_EMBEDDING_BACKEND=siliconflow
IMAGE_EMBEDDING_USE_EMBEDDING_CREDENTIALS=true
IMAGE_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
IMAGE_EMBEDDING_DIMENSIONS=1024
IMAGE_EMBEDDING_BATCH_SIZE=1
# For a separate account, set the shared-credentials flag to false:
# IMAGE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_EMBEDDING_API_KEY=
