# Optional for local startup. Copy to .env.infrastructure to enable.
# Install: .\.venv\Scripts\python.exe -m pip install -e ".[infrastructure]"
# Leave empty to disable Redis; rate limiting can still use local memory.
REDIS_URL=redis://127.0.0.1:6379/0
# Use a separate namespace for each deployment / data owner.
INFRA_NAMESPACE=deepsearch
EMBEDDING_CACHE_TTL_SECONDS=86400
# Downward jitter: TTL in [base-floor(base*ratio), base], at least 1 second.
# Set 0 for a matched fixed-TTL baseline. The freshness upper bound stays base.
EMBEDDING_CACHE_TTL_JITTER_RATIO=0.1
# In-process per-cache-client request coalescing, not a distributed Redis lock.
EMBEDDING_SINGLEFLIGHT_ENABLED=true
EMBEDDING_SINGLEFLIGHT_WAIT_SECONDS=65
EMBEDDING_SINGLEFLIGHT_MAX_KEYS=4096
# Maximum mutating API requests per socket peer per window. 0 disables.
API_RATE_LIMIT=30
API_RATE_WINDOW_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.3
REDIS_COOLDOWN_SECONDS=5
