# Optional inbound and outbound MCP. Disabled unless explicitly enabled.
MCP_ENABLED=false
MCP_SERVER_ENABLED=false
# External callers cannot trigger paid OCR by default.
MCP_SERVER_ALLOW_OCR=false
# JSON array of exact source URIs, e.g. ["pdf://<document-id>/paper.pdf"].
# [] means all sources already authorized by the local server provider.
MCP_SERVER_SOURCES=[]
# Trusted local JSON configuration path, relative to this env file.
# MCP_SERVERS_FILE=mcp-servers.json
MCP_TIMEOUT_SECONDS=30
MCP_MAX_TOOLS=12
MCP_MAX_METADATA_CHARS=32768
MCP_MAX_RESULT_CHARS=16000
MCP_MAX_IMAGE_BYTES=1000000
# Example secret referenced by token_env in a trusted server entry.
# PAPER_MCP_TOKEN=
