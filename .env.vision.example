# Copy settings into .env.vision. The selected model must accept image inputs.
VISION_BACKEND=disabled
VISION_USE_LLM_CREDENTIALS=false
VISION_API_KEY=
VISION_BASE_URL=https://api.example.com/v1
VISION_MODEL=
VISION_TIMEOUT_SECONDS=120
VISION_MAX_OUTPUT_TOKENS=8192
VISION_CONTEXT_WINDOW=32768
VISION_MAX_IMAGES=8
# Conservative per-page reservation; adjust for your provider's image accounting.
VISION_IMAGE_TOKEN_BUDGET=2500
